{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.js", "playwright.config.js", "vite-plugins/**/*.ts"]
}
